<?xml version="1.0" encoding="UTF-8" ?>
<!-- ============================================================
     Sorumlu Geliştirici: EREN (Eren_AuthUI) — Said tarafından güncellendi
     Dosya: AppShell.xaml
     Açıklama: Hamburger menü kaldırıldı (FlyoutBehavior=Disabled).
              Tek varsayılan sayfa HomeView. Diğer sayfalar
              AppShell.xaml.cs içinde Routing.RegisterRoute ile push
              navigasyon olarak kayıtlı (otomatik geri butonu çıkar).
     ============================================================ -->
<Shell
    x:Class="ArizaTakipSistemi.MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:home="clr-namespace:ArizaTakipSistemi.MAUI.Views"
    Title="Arıza Takip Sistemi"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent Title="Ana Sayfa"
                  ContentTemplate="{DataTemplate home:HomeView}"
                  Route="Home"/>

</Shell>
