<?xml version="1.0" encoding="utf-8" ?>
<!-- ============================================================
     Sorumlu Geliştirici: EREN (Eren_AuthUI)
     Dosya: Views/Auth/RegisterView.xaml
     Açıklama: Hesap Oluşturma (Kayıt Ol) Ekranı
     ============================================================ -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ArizaTakipSistemi.MAUI.Views.Auth.RegisterView"
             Title="Hesap Oluştur"
             BackgroundColor="#1a1a2e">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="30" VerticalOptions="Center">

            <!-- Başlık -->
            <Frame BackgroundColor="#16213e" BorderColor="Transparent" CornerRadius="20" Padding="25" HasShadow="True">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="📝" FontSize="45" HorizontalOptions="Center"/>
                    <Label Text="Hesap Oluştur" FontSize="24" FontAttributes="Bold" TextColor="#e94560" HorizontalOptions="Center"/>
                    <Label Text="Sisteme kayıt olmak için bilgilerinizi girin" FontSize="13" TextColor="#8899aa" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Ad -->
            <Label Text="Ad" TextColor="#8899aa" FontSize="13"/>
            <Frame BackgroundColor="#16213e" BorderColor="#333355" CornerRadius="12" Padding="5" HasShadow="False">
                <Entry x:Name="AdEntry" Placeholder="Adınız" PlaceholderColor="#667788" TextColor="White" FontSize="15"/>
            </Frame>

            <!-- Soyad -->
            <Label Text="Soyad" TextColor="#8899aa" FontSize="13"/>
            <Frame BackgroundColor="#16213e" BorderColor="#333355" CornerRadius="12" Padding="5" HasShadow="False">
                <Entry x:Name="SoyadEntry" Placeholder="Soyadınız" PlaceholderColor="#667788" TextColor="White" FontSize="15"/>
            </Frame>

            <!-- E-posta -->
            <Label Text="E-posta" TextColor="#8899aa" FontSize="13"/>
            <Frame BackgroundColor="#16213e" BorderColor="#333355" CornerRadius="12" Padding="5" HasShadow="False">
                <Entry x:Name="EmailEntry" Placeholder="ornek@email.com" PlaceholderColor="#667788" TextColor="White" Keyboard="Email" FontSize="15"/>
            </Frame>

            <!-- Telefon -->
            <Label Text="Telefon" TextColor="#8899aa" FontSize="13"/>
            <Frame BackgroundColor="#16213e" BorderColor="#333355" CornerRadius="12" Padding="5" HasShadow="False">
                <Entry x:Name="TelefonEntry" Placeholder="05xx xxx xx xx" PlaceholderColor="#667788" TextColor="White" Keyboard="Telephone" FontSize="15"/>
            </Frame>

            <!-- Şifre -->
            <Label Text="Şifre" TextColor="#8899aa" FontSize="13"/>
            <Frame BackgroundColor="#16213e" BorderColor="#333355" CornerRadius="12" Padding="5" HasShadow="False">
                <Entry x:Name="SifreEntry" Placeholder="En az 6 karakter" PlaceholderColor="#667788" TextColor="White" IsPassword="True" FontSize="15"/>
            </Frame>

            <!-- Şifre Tekrar -->
            <Label Text="Şifre Tekrar" TextColor="#8899aa" FontSize="13"/>
            <Frame BackgroundColor="#16213e" BorderColor="#333355" CornerRadius="12" Padding="5" HasShadow="False">
                <Entry x:Name="SifreTekrarEntry" Placeholder="Şifrenizi tekrar girin" PlaceholderColor="#667788" TextColor="White" IsPassword="True" FontSize="15"/>
            </Frame>

            <!-- Rol Seçimi -->
            <Label Text="Rol" TextColor="#8899aa" FontSize="13"/>
            <Frame BackgroundColor="#16213e" BorderColor="#333355" CornerRadius="12" Padding="5" HasShadow="False">
                <Picker x:Name="RolPicker" Title="Rol Seçin" TextColor="White" TitleColor="#667788">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Teknisyen</x:String>
                            <x:String>Yönetici</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Frame>

            <!-- Kayıt Butonu -->
            <Button x:Name="KayitButton" Text="HESAP OLUŞTUR"
                    FontSize="18" FontAttributes="Bold"
                    BackgroundColor="#27ae60" TextColor="White"
                    CornerRadius="12" HeightRequest="55"
                    Clicked="KayitButton_Clicked"/>

            <!-- Hata Mesajı -->
            <Label x:Name="HataMesaji" TextColor="#ff6b6b" FontSize="14" HorizontalOptions="Center" IsVisible="False"/>

            <!-- Giriş Sayfasına Dön -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Label Text="Zaten hesabınız var mı?" TextColor="#8899aa" FontSize="14" VerticalOptions="Center"/>
                <Button Text="Giriş Yap" BackgroundColor="Transparent" TextColor="#e94560"
                        FontSize="14" FontAttributes="Bold" Padding="0"
                        Clicked="GiriseSayfasinaGit_Clicked"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
