<?xml version="1.0" encoding="utf-8" ?>
<!-- ============================================================
     Sorumlu Geliştirici: EREN (Eren_AuthUI)
     Dosya: Views/Auth/PasswordChangeView.xaml
     Açıklama: Şifre Değiştirme Ekranı
     ============================================================ -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ArizaTakipSistemi.MAUI.Views.Auth.PasswordChangeView"
             Title="Şifre Değiştir"
             BackgroundColor="#1a1a2e">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

            <Frame BackgroundColor="#16213e" BorderColor="Transparent" CornerRadius="20" Padding="30" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="🔑 Şifre Değiştir"
                           FontSize="24" FontAttributes="Bold"
                           TextColor="#e94560" HorizontalOptions="Center"/>

                    <!-- Eski Şifre -->
                    <Label Text="Mevcut Şifre" TextColor="#8899aa" FontSize="13"/>
                    <Frame BackgroundColor="#0f3460" BorderColor="#333355" CornerRadius="10" Padding="5" HasShadow="False">
                        <Entry x:Name="EskiSifreEntry"
                               Placeholder="Mevcut şifreniz"
                               PlaceholderColor="#667788"
                               TextColor="White" IsPassword="True"/>
                    </Frame>

                    <!-- Yeni Şifre -->
                    <Label Text="Yeni Şifre" TextColor="#8899aa" FontSize="13"/>
                    <Frame BackgroundColor="#0f3460" BorderColor="#333355" CornerRadius="10" Padding="5" HasShadow="False">
                        <Entry x:Name="YeniSifreEntry"
                               Placeholder="Yeni şifreniz"
                               PlaceholderColor="#667788"
                               TextColor="White" IsPassword="True"/>
                    </Frame>

                    <!-- Yeni Şifre Tekrar -->
                    <Label Text="Yeni Şifre (Tekrar)" TextColor="#8899aa" FontSize="13"/>
                    <Frame BackgroundColor="#0f3460" BorderColor="#333355" CornerRadius="10" Padding="5" HasShadow="False">
                        <Entry x:Name="YeniSifreTekrarEntry"
                               Placeholder="Yeni şifrenizi tekrar girin"
                               PlaceholderColor="#667788"
                               TextColor="White" IsPassword="True"/>
                    </Frame>

                    <!-- Kaydet Butonu -->
                    <Button x:Name="KaydetButton"
                            Text="ŞİFREYİ DEĞİŞTİR"
                            FontSize="16" FontAttributes="Bold"
                            BackgroundColor="#e94560" TextColor="White"
                            CornerRadius="10" HeightRequest="50"
                            Clicked="KaydetButton_Clicked"/>

                    <Label x:Name="SonucMesaji"
                           FontSize="14" HorizontalOptions="Center"
                           IsVisible="False"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
