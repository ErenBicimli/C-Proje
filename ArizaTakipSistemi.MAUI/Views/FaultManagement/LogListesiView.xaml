<?xml version="1.0" encoding="utf-8" ?>
<!-- ============================================================
     Sorumlu Geliştirici: SAİD (Said_CrudUI)
     Dosya: Views/FaultManagement/LogListesiView.xaml
     Açıklama: Audit log ekranı. API'den /api/loglar uç noktasından çekilen
              kayıtları kim/ne zaman/ne yaptı şeklinde gösterir.
     ============================================================ -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ArizaTakipSistemi.MAUI.Views.FaultManagement.LogListesiView"
             Title="İşlem Geçmişi"
             BackgroundColor="#1a1a2e">

    <Grid RowDefinitions="Auto,*" Padding="15" RowSpacing="10">

        <!-- Üst başlık + yenile butonu -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="0">
                <Label Text="📜 İşlem Geçmişi " FontSize="20" FontAttributes="Bold" TextColor="#e94560"/>
                <Label x:Name="ToplamLabel" Text="0 kayıt" FontSize="12" TextColor="#8899aa"/>
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="🔄 Yenile" BackgroundColor="#16213e" TextColor="White"
                    CornerRadius="8" HeightRequest="36" FontSize="12" Clicked="Yenile_Clicked"/>
        </Grid>

        <!-- Log Listesi -->
        <CollectionView x:Name="LogCollectionView" Grid.Row="1">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="30">
                    <Label Text="📋" FontSize="50" HorizontalOptions="Center"/>
                    <Label Text="Henüz işlem kaydı yok" FontSize="16" TextColor="#8899aa" HorizontalOptions="Center"/>
                    <Label Text="Bir arıza ekleyip/güncelleyip silince burada görünür."
                           FontSize="12" TextColor="#667788" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="#16213e" BorderColor="{Binding IslemRengi}" CornerRadius="12"
                           Padding="14" Margin="0,5" HasShadow="True">
                        <VerticalStackLayout Spacing="6">

                            <!-- Üst satır: işlem türü badge + tablo adı -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Frame Grid.Column="0" BackgroundColor="{Binding IslemRengi}" CornerRadius="6"
                                       Padding="8,3" HasShadow="False" BorderColor="Transparent">
                                    <Label Text="{Binding IslemTuruAdi}" FontSize="11" FontAttributes="Bold" TextColor="White"/>
                                </Frame>
                                <Label Grid.Column="1" Text="{Binding TabloAdi, StringFormat='  → {0} #{1}'}"
                                       FontSize="12" TextColor="#8899aa" VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text="{Binding IslemEmoji}" FontSize="20" VerticalOptions="Center"/>
                            </Grid>

                            <!-- Yapılan işlemin açıklaması -->
                            <Label Text="{Binding YapilanIslem}" FontSize="14" TextColor="White" FontAttributes="Bold"/>

                            <!-- Alt satır: kullanıcı ve tarih -->
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="{Binding KullaniciAdi, StringFormat='👤 {0}'}" FontSize="12" TextColor="#aabbcc"/>
                                <Label Text="{Binding IslemTarihi, StringFormat='📅 {0:dd.MM.yyyy HH:mm}'}" FontSize="12" TextColor="#aabbcc"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
