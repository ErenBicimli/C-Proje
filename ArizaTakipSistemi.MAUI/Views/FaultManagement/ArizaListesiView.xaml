<?xml version="1.0" encoding="utf-8" ?>
<!-- ============================================================
     Sorumlu Geliştirici: SAİD (Said_CrudUI)
     Dosya: Views/FaultManagement/ArizaListesiView.xaml
     Açıklama: Arıza Listesi (Ana Sayfa).
     Düzen: Üstte sabit başlık (rol + isim). Altında TEK kaydırılabilir
            CollectionView: Header=özet+filtreler, ortada arıza kartları,
            Footer=Aylık Kazanç Hedefi göstergesi. Böylece tüm sayfa
            birlikte kayar.
     ============================================================ -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ArizaTakipSistemi.MAUI.Views.FaultManagement.ArizaListesiView"
             Title="Arıza Listesi"
             BackgroundColor="#1a1a2e">

    <Grid RowDefinitions="Auto,*" Padding="15" RowSpacing="10">

        <!-- ===== SABİT ÜST BAŞLIK ===== -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <Label Grid.Column="0" Text="🔧 Arıza Takip" FontSize="20" FontAttributes="Bold"
                   TextColor="#e94560" VerticalOptions="Center"/>
            <!-- Ortada: giriş yapılan ROL (büyük) + altında isim -->
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="0">
                <Label x:Name="RolLabel" Text="TEKNİKER" FontSize="16" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center"/>
                <Label x:Name="AdLabel" Text="" FontSize="12" TextColor="#8899aa" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

        <!-- ===== TEK KAYDIRILABİLİR LİSTE (header + kartlar + footer) ===== -->
        <CollectionView x:Name="ArizaCollectionView" Grid.Row="1">

            <!--  HEADER: özet kartları + durum butonları + arama + filtreler  -->
            <CollectionView.Header>
                <VerticalStackLayout Spacing="10" Padding="0,0,0,5">

                    <!-- Özet kartları -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Frame Grid.Column="0" BackgroundColor="#2a1a2e" BorderColor="#e94560" CornerRadius="12" Padding="12" HasShadow="True">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ArizaliKart_Tapped"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label x:Name="ArizaliSayiLabel" Text="0" FontSize="28" FontAttributes="Bold" TextColor="#e94560"/>
                                <Label Text="🔧 Arızalı Cihazlar" FontSize="12" TextColor="#aabbcc"/>
                                <Label Text="(tamamlanmamış)" FontSize="10" TextColor="#667788"/>
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Column="1" BackgroundColor="#1a2e22" BorderColor="#27ae60" CornerRadius="12" Padding="12" HasShadow="True">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TeslimKart_Tapped"/>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Label x:Name="TeslimSayiLabel" Text="0" FontSize="28" FontAttributes="Bold" TextColor="#27ae60"/>
                                <Label Text="✅ Teslim Bekleyen" FontSize="12" TextColor="#aabbcc"/>
                                <Label Text="(işlemi bitenler)" FontSize="10" TextColor="#667788"/>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- Durum butonları -->
                    <ScrollView Orientation="Horizontal">
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Tümü" BackgroundColor="#16213e" TextColor="White" CornerRadius="15" HeightRequest="35" FontSize="12" Clicked="FiltreTumu_Clicked"/>
                            <Button Text="🔴 Arızalı" BackgroundColor="#e94560" TextColor="White" CornerRadius="15" HeightRequest="35" FontSize="12" Clicked="FiltreArizali_Clicked"/>
                            <Button Text="Beklemede" BackgroundColor="#e67e22" TextColor="White" CornerRadius="15" HeightRequest="35" FontSize="12" Clicked="FiltreBeklemede_Clicked"/>
                            <Button Text="Devam Ediyor" BackgroundColor="#3498db" TextColor="White" CornerRadius="15" HeightRequest="35" FontSize="12" Clicked="FiltreDevamEdiyor_Clicked"/>
                            <Button Text="Tamamlandı" BackgroundColor="#27ae60" TextColor="White" CornerRadius="15" HeightRequest="35" FontSize="12" Clicked="FiltreTamamlandi_Clicked"/>
                            <Button Text="+ Yeni Arıza" BackgroundColor="#e94560" TextColor="White" CornerRadius="15" HeightRequest="35" FontSize="12" Clicked="YeniAriza_Clicked"/>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Arama çubuğu -->
                    <SearchBar x:Name="AramaCubugu" Placeholder="Arıza, kategori veya cihaz ara..."
                               PlaceholderColor="#667788" TextColor="White" BackgroundColor="#16213e"
                               CancelButtonColor="#e94560" TextChanged="AramaCubugu_TextChanged"/>

                    <!-- Gelişmiş filtre paneli -->
                    <Frame BackgroundColor="#16213e" BorderColor="#2a2a4a" CornerRadius="12" Padding="12" HasShadow="False">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Kategori Filtresi" TextColor="#8899aa" FontSize="12"/>
                            <Picker x:Name="KategoriFiltrePicker" TextColor="White" TitleColor="#667788" SelectedIndexChanged="KategoriFiltre_Changed">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Tüm Kategoriler</x:String>
                                        <x:String>Donanım</x:String>
                                        <x:String>Yazılım</x:String>
                                        <x:String>Ekran</x:String>
                                        <x:String>Batarya</x:String>
                                        <x:String>Ağ/İnternet</x:String>
                                        <x:String>Diğer</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                            <HorizontalStackLayout Spacing="10">
                                <Switch x:Name="TarihFiltresiSwitch" Toggled="TarihFiltresi_Toggled" OnColor="#e94560"/>
                                <Label Text="Tarihe göre filtrele" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Başlangıç" TextColor="#8899aa" FontSize="11"/>
                                    <DatePicker x:Name="BaslangicTarihi" TextColor="White" Format="dd.MM.yyyy" DateSelected="TarihSecildi"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Bitiş" TextColor="#8899aa" FontSize="11"/>
                                    <DatePicker x:Name="BitisTarihi" TextColor="White" Format="dd.MM.yyyy" DateSelected="TarihSecildi"/>
                                </VerticalStackLayout>
                            </Grid>
                            <Button Text="Filtreleri Temizle" BackgroundColor="#2a2a4a" TextColor="White" CornerRadius="8" HeightRequest="35" FontSize="12" Clicked="FiltreTemizle_Clicked"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Label Text="📋 Arıza Kayıtları" FontSize="15" FontAttributes="Bold" TextColor="White" Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </CollectionView.Header>

            <!--  BOŞ DURUM  -->
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="20">
                    <Label Text="📋" FontSize="50" HorizontalOptions="Center"/>
                    <Label Text="Kayıt bulunamadı" FontSize="16" TextColor="#8899aa" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!--  ARIZA KARTLARI (durum rengine boyalı)  -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="{Binding DurumRengi}" BorderColor="Transparent" CornerRadius="12"
                           Padding="15" Margin="0,5" HasShadow="True">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ArizaDetay_Tapped" CommandParameter="{Binding ArizaId}"/>
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding ArizaTanimi}" FontSize="15" FontAttributes="Bold" TextColor="White"
                                   LineBreakMode="TailTruncation" MaxLines="1"/>
                            <Label Text="{Binding DurumAdi}" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                            <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                                <Label Text="{Binding Cihaz.CihazBilgisi, StringFormat='📱 {0}'}" FontSize="13" TextColor="White"/>
                                <Label Text="{Binding Kategori, StringFormat='📂 {0}'}" FontSize="13" TextColor="White"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                                <Label Text="{Binding OncelikAdi, StringFormat='⚡ {0}'}" FontSize="12" TextColor="White"/>
                                <Label Text="{Binding OlusturulmaTarihi, StringFormat='📅 {0:dd.MM.yyyy}'}" FontSize="12" TextColor="White"/>
                                <Label Text="{Binding TahminiMaliyet, StringFormat='💰 {0:C}'}" FontSize="12" FontAttributes="Bold" TextColor="White"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>
