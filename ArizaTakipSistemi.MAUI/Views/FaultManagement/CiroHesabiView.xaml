<?xml version="1.0" encoding="utf-8" ?>
<!-- ============================================================
     Sorumlu Geliştirici: SAİD (Said_CrudUI)
     Dosya: Views/FaultManagement/CiroHesabiView.xaml
     Açıklama: Ciro Hesabı - Gelir ve Gider grafikleri yan yana,
               Net Ciro özet kartı, aylık hedef ayarlanabilir.
     ============================================================ -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ArizaTakipSistemi.MAUI.Views.FaultManagement.CiroHesabiView"
             Title="Ciro Hesabı"
             BackgroundColor="#1a1a2e">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="💰 Ciro Hesabı" FontSize="22" FontAttributes="Bold"
                   TextColor="#e94560" HorizontalOptions="Center"/>

            <!-- İKİ GAUGE YAN YANA -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                <!-- GELİR -->
                <Frame Grid.Column="0" BackgroundColor="#16213e" BorderColor="#27ae60"
                       CornerRadius="12" Padding="10" HasShadow="True">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="📈 Gelir" FontSize="14" FontAttributes="Bold"
                               TextColor="#27ae60" HorizontalOptions="Center"/>
                        <Grid WidthRequest="140" HeightRequest="140" HorizontalOptions="Center">
                            <GraphicsView x:Name="GelirGauge" HeightRequest="140" WidthRequest="140"/>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                                <Label x:Name="GelirYuzdeLabel" Text="%0" FontSize="22" FontAttributes="Bold"
                                       TextColor="White" HorizontalOptions="Center"/>
                                <Label Text="hedef" FontSize="10" TextColor="#8899aa" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                        <Label x:Name="GelirTutarLabel" Text="0 ₺" FontSize="14" FontAttributes="Bold"
                               TextColor="#27ae60" HorizontalOptions="Center"/>
                        <Label Text="(tamamlanan arızalar)" FontSize="10" TextColor="#8899aa"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- GİDER -->
                <Frame Grid.Column="1" BackgroundColor="#16213e" BorderColor="#e94560"
                       CornerRadius="12" Padding="10" HasShadow="True">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="📉 Gider" FontSize="14" FontAttributes="Bold"
                               TextColor="#e94560" HorizontalOptions="Center"/>
                        <Grid WidthRequest="140" HeightRequest="140" HorizontalOptions="Center">
                            <GraphicsView x:Name="GiderGauge" HeightRequest="140" WidthRequest="140"/>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                                <Label x:Name="GiderYuzdeLabel" Text="%0" FontSize="22" FontAttributes="Bold"
                                       TextColor="White" HorizontalOptions="Center"/>
                                <Label Text="gelir oranı" FontSize="10" TextColor="#8899aa" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                        <Label x:Name="GiderTutarLabel" Text="0 ₺" FontSize="14" FontAttributes="Bold"
                               TextColor="#e94560" HorizontalOptions="Center"/>
                        <Label Text="(tamamlanan masraflar)" FontSize="10" TextColor="#8899aa"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- NET CİRO ÖZET -->
            <Frame BackgroundColor="#0f3460" BorderColor="#3498db" CornerRadius="12" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="4">
                    <Label Text="NET CİRO" FontSize="12" TextColor="#aabbcc" HorizontalOptions="Center"/>
                    <Label x:Name="NetCiroLabel" Text="0 ₺" FontSize="28" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="(Gelir - Gider)" FontSize="11" TextColor="#8899aa" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- AYLIK HEDEF AYARI -->
            <Frame BackgroundColor="#16213e" BorderColor="#2a2a4a" CornerRadius="12" Padding="12" HasShadow="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="🎯 Aylık Kazanç Hedefi" FontSize="14" FontAttributes="Bold" TextColor="#e94560"/>
                    <Label x:Name="HedefLabel" Text="Hedef: 0 ₺" FontSize="12" TextColor="#aabbcc"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Frame Grid.Column="0" BackgroundColor="#1a1a2e" BorderColor="#333355"
                               CornerRadius="8" Padding="3" HasShadow="False">
                            <Entry x:Name="HedefEntry" Placeholder="Hedef tutar (₺)" Keyboard="Numeric"
                                   TextColor="White" PlaceholderColor="#667788"/>
                        </Frame>
                        <Button Grid.Column="1" Text="Hedefi Güncelle" BackgroundColor="#3498db"
                                TextColor="White" CornerRadius="8" HeightRequest="40" FontSize="12"
                                Clicked="HedefGuncelle_Clicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Gideri sıfırlama (yönetici için iyi olur) -->
            <Button Text="Gider Sayacını Sıfırla" BackgroundColor="#2a2a4a" TextColor="#aabbcc"
                    CornerRadius="8" HeightRequest="36" FontSize="11" Clicked="GiderSifirla_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
