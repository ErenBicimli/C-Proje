<?xml version="1.0" encoding="utf-8" ?>
<!-- ============================================================
     Sorumlu Geliştirici: SAİD (Said_CrudUI)
     Dosya: Views/FaultManagement/ArizaGuncelleView.xaml
     Açıklama: Arıza Güncelleme/Detay Ekranı
     ============================================================ -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ArizaTakipSistemi.MAUI.Views.FaultManagement.ArizaGuncelleView"
             Title="Arıza Detay / Güncelle"
             BackgroundColor="#1a1a2e">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <Label Text="🔍 Arıza Detay" FontSize="22" FontAttributes="Bold" TextColor="#e94560"/>

            <!-- Cihaz Bilgisi (Salt Okunur) -->
            <Frame BackgroundColor="#0f3460" BorderColor="#333355" CornerRadius="12" Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Cihaz Bilgisi" TextColor="#e94560" FontSize="14" FontAttributes="Bold"/>
                    <Label x:Name="CihazBilgiLabel" TextColor="White" FontSize="15"/>
                    <Label x:Name="MusteriBilgiLabel" TextColor="#aabbcc" FontSize="13"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Arıza Tanımı -->
            <Label Text="Arıza Tanımı" TextColor="#8899aa" FontSize="13"/>
            <Frame BackgroundColor="#16213e" BorderColor="#333355" CornerRadius="10" Padding="5">
                <Editor x:Name="ArizaTanimiEditor" TextColor="White" HeightRequest="80" AutoSize="TextChanges"/>
            </Frame>

            <!-- Durum -->
            <Label Text="Durum" TextColor="#8899aa" FontSize="13"/>
            <Frame BackgroundColor="#16213e" BorderColor="#333355" CornerRadius="10" Padding="5">
                <Picker x:Name="DurumPicker" TextColor="White" TitleColor="#667788">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Beklemede</x:String>
                            <x:String>Devam Ediyor</x:String>
                            <x:String>Tamamlandı</x:String>
                            <x:String>İptal Edildi</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Frame>

            <!-- Öncelik -->
            <Label Text="Öncelik" TextColor="#8899aa" FontSize="13"/>
            <Frame BackgroundColor="#16213e" BorderColor="#333355" CornerRadius="10" Padding="5">
                <Picker x:Name="OncelikPicker" TextColor="White" TitleColor="#667788">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Düşük</x:String>
                            <x:String>Normal</x:String>
                            <x:String>Yüksek</x:String>
                            <x:String>Acil</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Frame>

            <!-- Yapılan İşlem -->
            <Label Text="Yapılan İşlem" TextColor="#8899aa" FontSize="13"/>
            <Frame BackgroundColor="#16213e" BorderColor="#333355" CornerRadius="10" Padding="5">
                <Editor x:Name="YapilanIslemEditor" Placeholder="Yapılan işlemi açıklayın..."
                        PlaceholderColor="#667788" TextColor="White" HeightRequest="80" AutoSize="TextChanges"/>
            </Frame>

            <!-- Maliyet -->
            <Label Text="Tahmini Maliyet (₺)" TextColor="#8899aa" FontSize="13"/>
            <Frame BackgroundColor="#16213e" BorderColor="#333355" CornerRadius="10" Padding="5">
                <Entry x:Name="MaliyetEntry" PlaceholderColor="#667788" TextColor="White" Keyboard="Numeric"/>
            </Frame>

            <!-- Tarih Bilgileri -->
            <Frame BackgroundColor="#0f3460" BorderColor="#333355" CornerRadius="12" Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label x:Name="OlusturulmaTarihiLabel" TextColor="#8899aa" FontSize="12"/>
                    <Label x:Name="GuncellemeTarihiLabel" TextColor="#8899aa" FontSize="12"/>
                    <Label x:Name="TamamlanmaTarihiLabel" TextColor="#44bb88" FontSize="12"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Butonlar -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" x:Name="GuncelleButton" Text="GÜNCELLE"
                        BackgroundColor="#27ae60" TextColor="White" CornerRadius="10"
                        HeightRequest="50" FontAttributes="Bold"
                        Clicked="GuncelleButton_Clicked"/>
                <Button Grid.Column="1" x:Name="SilButton" Text="SİL"
                        BackgroundColor="#c0392b" TextColor="White" CornerRadius="10"
                        HeightRequest="50" FontAttributes="Bold"
                        Clicked="SilButton_Clicked"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
